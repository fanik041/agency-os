# Postgres connection string for running migrations from scripts.
# Get from Supabase Dashboard → Project Settings → Database → "Connection string" (URI mode).
# Use the POOLER URL on port 6543 (or direct on 5432 for migrations).
DATABASE_URL=

# Railway scraper auth
SCRAPER_SERVICE_URL=
SCRAPER_SECRET=

# Auth
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
ALLOW_SIGNUPS=false
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# OpenAI (lead scoring)
OPENAI_API_KEY=

# Vercel (programmatic deploys)
VERCEL_TOKEN=
VERCEL_TEAM_ID=

# Email
RESEND_API_KEY=
